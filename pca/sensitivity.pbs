#!/bin/bash
#PBS -q auto_free
#PBS -N pca_qd_replay
#PBS -j oe
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=16:mem=48gb
set -euo pipefail
cd "$PBS_O_WORKDIR"
: "${PCA_MANIFEST:?set PCA_MANIFEST}"
: "${PCA_STUDY:?set PCA_STUDY to the completed numerical checkpoint}"
: "${PCA_RUN:?set PCA_RUN}"
module load SciPy-bundle/2025.06-gfbf-2025a
python3 pca/sensitivity.py --manifest "$PCA_MANIFEST" --study "$PCA_STUDY" \
    --out "$PCA_RUN" --workers 16
