#!/bin/bash
#PBS -q batch_gpu
#PBS -N pca_gpu_check
#PBS -j oe
#PBS -l walltime=00:45:00
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
set -euo pipefail
cd "$PBS_O_WORKDIR"
: "${PCA_MANIFEST:?set PCA_MANIFEST}"
: "${PCA_RUN:?set PCA_RUN to a new output parent}"
mkdir "$PCA_RUN"
hostname > "$PCA_RUN/host.txt"
nvidia-smi -q > "$PCA_RUN/nvidia-smi.txt"
module load OpenMPI/5.0.8-GCC-14.3.0 CMake/4.0.3-GCCcore-14.3.0 CUDA/12.9.1
cmake -S pca -B pca/build_cuda -DPCA_CUDA=ON -DPCA_MPI=ON
cmake --build pca/build_cuda -j 4
export OMP_NUM_THREADS=1
pca/build_cuda/pca_gpu_test "$PCA_RUN/kernel_validation.json"
for precision in float double; do
    pca/build_cuda/pca_run --manifest "$PCA_MANIFEST" --out "$PCA_RUN/$precision" \
        --device cuda --precision "$precision" --count 40 --chunk 16
done
module purge
module load SciPy-bundle/2025.06-gfbf-2025a
for precision in float double; do
    python3 pca/validate.py --manifest "$PCA_MANIFEST" --run "$PCA_RUN/$precision" \
        > "$PCA_RUN/$precision/validation.log" 2>&1
done
touch "$PCA_RUN/SUCCESS"
