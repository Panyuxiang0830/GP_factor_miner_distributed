#!/bin/bash
#PBS -q auto_free
#PBS -N pca_raw_scaling
#PBS -j oe
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=180gb
#PBS -l place=scatter
set -euo pipefail
cd "$PBS_O_WORKDIR"
: "${PCA_RUN:?set PCA_RUN}"
: "${PCA_MANIFEST:?set PCA_MANIFEST to synthetic numeric input}"
mkdir "$PCA_RUN"
module load OpenMPI/5.0.8-GCC-14.3.0 CMake/4.0.3-GCCcore-14.3.0
build="${PCA_RUN}_build"
cmake -S pca -B "$build" -DPCA_MPI=ON
cmake --build "$build" -j 4
export OMP_NUM_THREADS=1 PRTE_MCA_prte_launch_agent="$PWD/scripts/vanda/prted.sh"
sort -u "$PBS_NODEFILE" > "$PCA_RUN/hosts.txt"
hosts=$(wc -l < "$PCA_RUN/hosts.txt")
while read -r host; do ssh "$host" lscpu > "$PCA_RUN/cpu_${host%%.*}.txt"; done < "$PCA_RUN/hosts.txt"
python3 - "$PCA_MANIFEST" "$PCA_RUN" <<'PY'
import json,pathlib,sys
manifest=json.loads(pathlib.Path(sys.argv[1]).read_text())
assert len(manifest['records'])==9216
assert manifest['rows']==293 and manifest['cols']==5876
pathlib.Path(sys.argv[2],'experiment.json').write_text(json.dumps(dict(
    input_interpretation='Synthetic DCT+noise matrices interpreted as unranked sampled numeric panels; ranking reconstructs R. Not market factors.',
    rank_input=1,transpose_preserves_cpu_double_ranks=True),indent=2)+'\n')
PY
for layout in date transpose factor; do
    for repeat in 0 1 2 3; do
        mpirun -np "$((hosts*72))" --hostfile "$PCA_RUN/hosts.txt" --map-by ppr:72:node --bind-to core \
            "$build/pca_run" --manifest "$PCA_MANIFEST" --out "$PCA_RUN/raw_${layout}_p$((hosts*72))_t1_r${repeat}" \
            --count 9216 --chunk 576 --layout "$layout" --rank-input 1
    done
done
touch "$PCA_RUN/SUCCESS"
