#!/bin/bash
#PBS -q auto_free
#PBS -N pca_precision
#PBS -j oe
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=8:mpiprocs=4:ngpus=1:mem=64gb
set -euo pipefail
cd "$PBS_O_WORKDIR"
: "${PCA_RUN:?set PCA_RUN}"
: "${PCA_MANIFEST:?set PCA_MANIFEST}"
: "${PCA_BASELINE:?set PCA_BASELINE}"
mkdir "$PCA_RUN"
module load OpenMPI/5.0.8-GCC-14.3.0 CMake/4.0.3-GCCcore-14.3.0 CUDA/12.9.1
build="${PCA_RUN}_build"
cmake -S pca -B "$build" -DPCA_MPI=ON -DPCA_CUDA=ON
cmake --build "$build" -j 4
export OMP_NUM_THREADS=1 PRTE_MCA_prte_launch_agent="$PWD/scripts/vanda/prted.sh"
"$build/pca_gpu_test" "$PCA_RUN/kernel_validation.json"
for precision in float double; do
    "$build/pca_run" --manifest "$PCA_MANIFEST" --out "$PCA_RUN/full_$precision" \
        --count 9388 --chunk 128 --device cuda --precision "$precision" --layout factor
done
module purge
module load SciPy-bundle/2025.06-gfbf-2025a
python3 pca/synthetic.py --out "$PCA_RUN/raw_input" --rows 24 --cols 257 --factors 8
module purge
module load OpenMPI/5.0.8-GCC-14.3.0 CUDA/12.9.1
for precision in float double; do
    "$build/pca_run" --manifest "$PCA_RUN/raw_input/manifest.json" --out "$PCA_RUN/raw_$precision" \
        --count 8 --chunk 8 --device cuda --precision "$precision" --rank-input 1
done
for layout in factor transpose; do
    mpirun -np 4 --map-by slot --bind-to core "$build/pca_run" \
        --manifest "$PCA_RUN/raw_input/manifest.json" --out "$PCA_RUN/raw_cpu_$layout" \
        --count 8 --chunk 8 --layout "$layout" --rank-input 1
done
module purge
module load SciPy-bundle/2025.06-gfbf-2025a
for precision in float double; do
    python3 pca/validate.py --manifest "$PCA_MANIFEST" --run "$PCA_RUN/full_$precision" \
        --power-reference "$PCA_BASELINE" > "$PCA_RUN/full_$precision/validation.log" 2>&1
    python3 pca/validate.py --manifest "$PCA_RUN/raw_input/manifest.json" --run "$PCA_RUN/raw_$precision" \
        > "$PCA_RUN/raw_$precision/validation.log" 2>&1
done
for layout in factor transpose; do
    python3 pca/validate.py --manifest "$PCA_RUN/raw_input/manifest.json" --run "$PCA_RUN/raw_cpu_$layout" \
        > "$PCA_RUN/raw_cpu_$layout/validation.log" 2>&1
done
python3 - "$PCA_RUN" <<'PY'
import json,pathlib,sys
root=pathlib.Path(sys.argv[1])
assert (root/'raw_cpu_factor/signatures.f32').read_bytes()==(root/'raw_cpu_transpose/signatures.f32').read_bytes()
f=json.loads((root/'full_float/decisions.json').read_text())
d=json.loads((root/'full_double/decisions.json').read_text())
assert len(f)==len(d)
actions=sum(x['action']!=y['action'] for x,y in zip(f,d))
tuples=sum((x['action'],x['closest_key'],x['replaced_key'])!=(y['action'],y['closest_key'],y['replaced_key']) for x,y in zip(f,d))
keys_f=set(json.loads((root/'full_float/archive_keys.json').read_text()))
keys_d=set(json.loads((root/'full_double/archive_keys.json').read_text()))
(root/'SUCCESS.json').write_text(json.dumps(dict(validated=True,fp32_vs_fp64_changed_actions=actions,
    fp32_vs_fp64_changed_decision_tuples=tuples,archive_key_symmetric_difference=len(keys_f^keys_d),
    cpu_raw_double_ranks_transpose_bitwise=True),indent=2)+'\n')
PY
