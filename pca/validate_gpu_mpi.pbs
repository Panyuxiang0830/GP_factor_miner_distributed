#!/bin/bash
#PBS -q auto_free
#PBS -N pca_two_gpu
#PBS -j oe
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=16:mpiprocs=2:ngpus=2:mem=64gb
set -euo pipefail
cd "$PBS_O_WORKDIR"
: "${PCA_MANIFEST:?set PCA_MANIFEST}"
: "${PCA_RUN:?set PCA_RUN}"
mkdir "$PCA_RUN"
hostname > "$PCA_RUN/host.txt"
nvidia-smi -q > "$PCA_RUN/nvidia-smi.txt"
module load OpenMPI/5.0.8-GCC-14.3.0 CMake/4.0.3-GCCcore-14.3.0 CUDA/12.9.1
ompi_info --parsable --all > "$PCA_RUN/mpi_info.txt"
cmake -S pca -B pca/build_cuda_mpi -DPCA_CUDA=ON -DPCA_MPI=ON
cmake --build pca/build_cuda_mpi -j 4
export OMP_NUM_THREADS=1
export PRTE_MCA_prte_launch_agent="$PWD/scripts/vanda/prted.sh"
binary="$PWD/pca/build_cuda_mpi/pca_run"
for precision in float double; do
    for ranks in 1 2; do
        mpirun -np "$ranks" --map-by slot --bind-to core "$binary" \
            --manifest "$PCA_MANIFEST" --out "$PCA_RUN/check_${precision}_${ranks}" \
            --device cuda --precision "$precision" --layout date --cuda-aware 1 --count 40 --chunk 16
    done
done
# Same workload on one and two devices; repeat 0 is a retained warmup.
for ranks in 1 2; do
    for repeat in 0 1 2 3; do
        mpirun -np "$ranks" --map-by slot --bind-to core "$binary" \
            --manifest "$PCA_MANIFEST" --out "$PCA_RUN/strong_gpu_p${ranks}_r${repeat}" \
            --device cuda --precision float --layout date --cuda-aware 1 \
            --count "${PCA_COUNT:-9388}" --chunk 128
    done
done
module purge
module load SciPy-bundle/2025.06-gfbf-2025a
for precision in float double; do
    for ranks in 1 2; do
        python3 pca/validate.py --manifest "$PCA_MANIFEST" --run "$PCA_RUN/check_${precision}_${ranks}" \
            > "$PCA_RUN/check_${precision}_${ranks}/validation.log" 2>&1
    done
done
touch "$PCA_RUN/SUCCESS"
