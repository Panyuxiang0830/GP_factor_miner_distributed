#!/bin/bash
#PBS -q auto_free
#PBS -N pca_archive_size
#PBS -j oe
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=96gb
set -euo pipefail
cd "$PBS_O_WORKDIR"
: "${PCA_RUN:?set PCA_RUN}"
mkdir "$PCA_RUN"
module load OpenMPI/5.0.8-GCC-14.3.0 CMake/4.0.3-GCCcore-14.3.0
build="${PCA_RUN}_build"
cmake -S pca -B "$build" -DPCA_MPI=ON
cmake --build "$build" -j 4
export OMP_NUM_THREADS=1 PRTE_MCA_prte_launch_agent="$PWD/scripts/vanda/prted.sh"
for A in 1000 5000 10000 50000; do
    for repeat in 0 1 2 3; do
        mpirun -np 1 --bind-to core "$build/pca_archive_bench" "$A" 128 293 root "$PCA_RUN/root_A${A}_p1_r${repeat}.json"
        for ranks in 4 16 72; do
            mpirun -np "$ranks" --map-by slot --bind-to core "$build/pca_archive_bench" \
                "$A" 128 293 mpi "$PCA_RUN/mpi_A${A}_p${ranks}_r${repeat}.json"
        done
    done
done
touch "$PCA_RUN/SUCCESS"
