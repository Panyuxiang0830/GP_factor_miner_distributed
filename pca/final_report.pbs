#!/bin/bash
#PBS -q auto_free
#PBS -N pca_report
#PBS -j oe
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=12gb
set -euo pipefail
cd "$PBS_O_WORKDIR"
: "${PCA_RUN:?set PCA_RUN to a new report directory}"
module load SciPy-bundle/2025.06-gfbf-2025a matplotlib/3.10.3-gfbf-2025a
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
python3 pca/assemble_report.py --out "$PCA_RUN" \
    --scaling-validation scaling_validation_local_01 \
    --synthetic-validation synthetic_validation_01
