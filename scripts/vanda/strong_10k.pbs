#!/bin/bash
# 10,000-expression batch (real GP warm-start batch, depth <= 2):
# X2 strong and X3 weak scaling on one node, consistency at 72 ranks.
# Weak scaling uses the first 1000 expressions (64 synthetic dates per rank
# with the full batch would not fit in memory at 72 ranks).
#PBS -P personal-panyuxiang
#PBS -N gpe10k_1node
#PBS -j oe
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=450gb
#PBS -l place=scatter:excl

cd "$PBS_O_WORKDIR"
export GP_EXPRS=/scratch/$USER/gp_data/batch10k_d2_warm.json
export OUT=/scratch/$USER/gp_runs/10k
source scripts/vanda/env.sh
# Configurations that take over half an hour (P or threads <= 4) run once;
# the rest keep warm-up 1 + 3 repeats.
ONE="--warmup 0 --repeat 1"
REP="--warmup 1 --repeat 3"
C="--chunk 1000"
for P in 1 2 4; do bench $P 1 1 $ONE $C --csv $OUT/x2_strong.csv --label strong; done
for P in 8 16 36 72; do bench $P 1 1 $REP $C --csv $OUT/x2_strong.csv --label strong; done
for P in 1 2 4 8 16 36 72; do bench $P 1 1 $REP --chunk 500 --exprs 1000 --synthetic $((64 * P)) --csv $OUT/x3_weak.csv --label weak; done
consistency 72 1 1 0 1000 op 1000
echo DONE
