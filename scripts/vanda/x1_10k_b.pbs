#!/bin/bash
# 10,000-expression batch (real GP warm-start batch, depth <= 2):
# X1 serial, batch-size sweep and synthetic T/N (first 500 expressions,
# since synthetic T x 8 on more expressions exceeds the node memory).
#PBS -P personal-panyuxiang
#PBS -N gpe10k_x1b
#PBS -j oe
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=450gb
#PBS -l place=scatter:excl

cd "$PBS_O_WORKDIR"
export GP_EXPRS=/scratch/$USER/gp_data/batch10k_d2_warm.json
export OUT=/scratch/$USER/gp_runs/10k
source scripts/vanda/env.sh
# Configurations that take over half an hour (P or threads <= 4) run once;
# the rest keep warm-up 1 + 3 repeats.
ONE="--warmup 0 --repeat 1"
REP="--warmup 1 --repeat 3"
B="$ONE --chunk 1000 --csv $OUT/x1_serial.csv"
for E in 625 1250 2500 5000; do bench 1 1 1 --exprs $E $B --label batch_real; done
for T in 1461 2922 5844 11688; do bench 1 1 1 --synthetic $T --exprs 500 $B --label T_synthetic; done
for N in 5876 11752 23504; do bench 1 1 1 --synthetic 1461 --stocks $N --exprs 500 $B --label N_synthetic; done
echo DONE
