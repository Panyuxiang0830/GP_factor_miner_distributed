#!/bin/bash
# 10,000-expression batch (real GP warm-start batch, depth <= 2):
# two nodes, strong and weak scaling at 144 ranks, H0 scan last.
#PBS -P personal-panyuxiang
#PBS -N gpe10k_2node
#PBS -j oe
#PBS -l walltime=06:00:00
#PBS -l select=2:ncpus=72:mpiprocs=72:mem=450gb
#PBS -l place=scatter:excl

cd "$PBS_O_WORKDIR"
export GP_EXPRS=/scratch/$USER/gp_data/batch10k_d2_warm.json
export OUT=/scratch/$USER/gp_runs/10k
source scripts/vanda/env.sh
# Configurations that take over half an hour (P or threads <= 4) run once;
# the rest keep warm-up 1 + 3 repeats.
ONE="--warmup 0 --repeat 1"
REP="--warmup 1 --repeat 3"
C="--chunk 2000"
bench 144 1 2 $REP $C --csv $OUT/x2_strong.csv --label strong
bench 144 1 2 $REP --chunk 500 --exprs 1000 --synthetic $((64 * 144)) --csv $OUT/x3_weak.csv --label weak
for H in 0 10 30 60 89; do bench 144 1 2 $REP $C --H0 $H --csv $OUT/x4_comm.csv --label h0_scan; done
echo DONE
