#!/bin/bash
# 10,000-expression batch (real GP warm-start batch, depth <= 2):
# four nodes: strong and weak scaling at 288 ranks, ranks spread
# over four nodes, MPI x OpenMP splits, consistency, then the H0 scans.
#PBS -P personal-panyuxiang
#PBS -N gpe10k_4node
#PBS -j oe
#PBS -l walltime=12:00:00
#PBS -l select=4:ncpus=72:mpiprocs=72:mem=450gb
#PBS -l place=scatter:excl

cd "$PBS_O_WORKDIR"
export GP_EXPRS=/scratch/$USER/gp_data/batch10k_d2_warm.json
export OUT=/scratch/$USER/gp_runs/10k
source scripts/vanda/env.sh
# Configurations that take over half an hour (P or threads <= 4) run once;
# the rest keep warm-up 1 + 3 repeats.
ONE="--warmup 0 --repeat 1"
REP="--warmup 1 --repeat 3"
C="--chunk 2000"
bench 288 1 4 $REP $C --csv $OUT/x2_strong.csv --label strong
bench 288 1 4 $REP --chunk 500 --exprs 1000 --synthetic $((64 * 288)) --csv $OUT/x3_weak.csv --label weak
for P in 36 72 144; do bench $P 1 4 $REP $C --csv $OUT/x4_comm.csv --label spread4; done
for rt in 144:2 72:4 36:8 16:18 8:36 4:72; do
    for m in op node; do bench ${rt%:*} ${rt#*:} 4 $REP $C --threads $m --csv $OUT/x5_hybrid.csv --label hybrid; done
done
consistency 288 1 4 0 1000 op 2000
consistency 16 18 4 0 1000 node 2000
for H in 0 10 30 60 89; do bench 288 1 4 $REP $C --H0 $H --csv $OUT/x4_comm.csv --label h0_scan; done
for rt in 72:4 16:18 4:72; do
    for H in 10 30 60 89; do bench ${rt%:*} ${rt#*:} 4 $REP $C --H0 $H --csv $OUT/x4_comm.csv --label h0_hybrid; done
done
echo DONE
